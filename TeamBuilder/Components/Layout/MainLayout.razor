@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager

<PageTitle>@_appTitle</PageTitle>

<div class="pokedex-shell">
    <header class="pokedex-topbar">
        <div class="pokedex-brand">
            <span class="pokedex-logo-ball" aria-hidden="true">
                <span class="pokedex-logo-ball-inner"></span>
            </span>
            <span class="pokedex-app-title">@_appTitle</span>
        </div>

        <nav class="pokedex-nav">
            <NavLink href="" Match="NavLinkMatch.All">Raid Builder</NavLink>
            <NavLink href="iv-lookup">IV Rank</NavLink>
            <span class="pokedex-nav-placeholder">My Pokemon</span>
            <span class="pokedex-nav-placeholder">Tier Lists</span>
        </nav>

        <div class="pokedex-topbar-right">
            <div class="pokedex-lights" aria-hidden="true">
                <span class="pokedex-light red"></span>
                <span class="pokedex-light yellow"></span>
                <span class="pokedex-light green"></span>
            </div>
            <div class="pokedex-hamburger" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </header>

    <main class="pokedex-screen">
        <article class="content">
            @Body
        </article>
    </main>

    <footer class="pokedex-bottombar">
        <div class="pokedex-bottombar-inner">
            <div class="pokedex-bracket" aria-hidden="true">
                <div class="pokedex-vents">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
            <div class="pokedex-footer-ball" aria-hidden="true">
                <span class="pokedex-footer-ball-center"></span>
            </div>
        </div>
    </footer>

    <span class="pokedex-stripe pokedex-stripe-top" aria-hidden="true"></span>
    <span class="pokedex-stripe pokedex-stripe-bottom" aria-hidden="true"></span>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _appTitle = "Pokémon Go Team Builder";

    protected override void OnInitialized()
    {
        SetAppTitle(NavigationManager.Uri);
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SetAppTitle(e.Location);
        _ = InvokeAsync(StateHasChanged);
    }

    private void SetAppTitle(string uri)
    {
        var relative = NavigationManager.ToBaseRelativePath(uri).Trim('/');
        _appTitle = relative switch
        {
            _ when string.Equals(relative, "iv-lookup", StringComparison.OrdinalIgnoreCase) => "IV Rank Checker",
            _ => "Pokémon Go Team Builder"
        };
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
