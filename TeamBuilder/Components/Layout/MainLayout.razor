@inherits LayoutComponentBase

<div class="page">
    <main>
        <div class="top-row top-row-navbar">
            <nav class="top-nav">
                <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink href="iv-lookup">IV Lookup</NavLink>
            </nav>
            <span class="app-title">Pokémon Go Team Builder</span>
            <div class="top-row-spacer" aria-hidden="true"></div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
