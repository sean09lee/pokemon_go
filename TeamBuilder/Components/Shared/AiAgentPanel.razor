@using TeamBuilder.Data.Models
@using TeamBuilder.Services.Contracts
@inject IAIAdvisorService AIAdvisorService

<div class="tb-ai-panel">
    <div class="tb-ai-header">
        <span class="tb-ai-eyebrow">PROFESSOR OAK</span>
        <span class="tb-ai-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
        </span>
    </div>

    <div class="tb-ai-intro">
        <span class="tb-ai-avatar" aria-hidden="true">
            <LucideIcon Name="users" Size="22" />
        </span>
        <div>
            <h2 class="tb-ai-title">Professor Oak</h2>
            <p class="tb-ai-subtitle">Your Pokémon GO assistant</p>
        </div>
    </div>

    @if (_conversation.Count == 0 && !_isSending)
    {
        <p class="tb-ai-welcome">
            Welcome! I can help answer your questions about raids, using Poké Genie, exporting your data, and powering up Pokémon.
        </p>

        <div class="tb-ai-suggestions">
            <button type="button" class="tb-ai-suggestion" @onclick='@(() => AskSuggestion("How do I export from Poké Genie?"))'>
                <span class="tb-ai-suggestion-icon" aria-hidden="true"><LucideIcon Name="book-open" Size="16" /></span>
                <span class="tb-ai-suggestion-text">How do I export from Poké Genie?</span>
                <span class="tb-ai-suggestion-chevron" aria-hidden="true"><LucideIcon Name="chevron-right" Size="16" /></span>
            </button>
            <button type="button" class="tb-ai-suggestion" @onclick='@(() => AskSuggestion("What is a raid team?"))'>
                <span class="tb-ai-suggestion-icon" aria-hidden="true"><LucideIcon Name="users" Size="16" /></span>
                <span class="tb-ai-suggestion-text">What is a raid team?</span>
                <span class="tb-ai-suggestion-chevron" aria-hidden="true"><LucideIcon Name="chevron-right" Size="16" /></span>
            </button>
            <button type="button" class="tb-ai-suggestion" @onclick='@(() => AskSuggestion("Which Pokémon are worth powering up?"))'>
                <span class="tb-ai-suggestion-icon" aria-hidden="true"><LucideIcon Name="chart-no-axes-column-increasing" Size="16" /></span>
                <span class="tb-ai-suggestion-text">Which Pokémon are worth powering up?</span>
                <span class="tb-ai-suggestion-chevron" aria-hidden="true"><LucideIcon Name="chevron-right" Size="16" /></span>
            </button>
        </div>

        <div class="tb-ai-tip">
            <span class="tb-ai-tip-icon" aria-hidden="true"><LucideIcon Name="lightbulb" Size="16" /></span>
            <span><strong>Tip:</strong> Uploading a CSV enables personalized recommendations based on your Pokémon, items, and resources.</span>
        </div>
    }

    <div class="tb-ai-history">
        @foreach (var message in _conversation)
        {
            <div class="tb-ai-message @(message.IsUser ? "tb-ai-message-user" : "tb-ai-message-agent")">
                <span class="tb-ai-message-sender">@(message.IsUser ? "You" : "Professor Oak")</span>
                <span class="tb-ai-message-text">@message.Text</span>
            </div>
        }

        @if (_isSending)
        {
            <div class="tb-ai-message tb-ai-message-agent">
                <span class="tb-ai-message-sender">Professor Oak</span>
                <span class="tb-ai-message-text"><em>Thinking...</em></span>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger tb-ai-alert" role="alert">@_errorMessage</div>
    }

    <div class="tb-ai-input-row">
        <input class="form-control"
               type="text"
               placeholder="Ask Professor Oak..."
               @bind="_inputText"
               @bind:event="oninput"
               @onkeydown="HandleKeyDown"
               disabled="@_isSending" />
        <button class="btn btn-primary" type="button" @onclick="SendMessageAsync" disabled="@(_isSending || string.IsNullOrWhiteSpace(_inputText))">
            Send
        </button>
    </div>
</div>

@code {
    private readonly List<AiChatMessage> _conversation = new();
    private string _inputText = string.Empty;
    private string? _errorMessage;
    private bool _isSending;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isSending && !string.IsNullOrWhiteSpace(_inputText))
        {
            await SendMessageAsync();
        }
    }

    private async Task AskSuggestion(string question)
    {
        _inputText = question;
        await SendMessageAsync();
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_inputText) || _isSending)
        {
            return;
        }

        _errorMessage = null;
        var userMessage = new AiChatMessage { IsUser = true, Text = _inputText.Trim() };
        _conversation.Add(userMessage);
        _inputText = string.Empty;
        _isSending = true;

        try
        {
            var response = await AIAdvisorService.SendMessageAsync(_conversation);
            _conversation.Add(response);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Something went wrong contacting Professor Oak: {ex.Message}";
        }
        finally
        {
            _isSending = false;
        }
    }
}

