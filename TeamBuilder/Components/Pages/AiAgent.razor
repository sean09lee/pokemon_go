@page "/ai-agent"
@using TeamBuilder.Data.Models
@using TeamBuilder.Services.Services
@inject AIAdvisorService AIAdvisorService
@rendermode InteractiveServer

<PageTitle>AI Agent</PageTitle>

<div class="ai-agent-shell">
    <div class="ai-chat-card p-3 mb-3">
        <h3>AI Agent</h3>

        <div class="ai-chat-history mb-3">
            @foreach (var message in _conversation)
            {
                <div class="ai-chat-message @(message.IsUser ? "ai-chat-message-user" : "ai-chat-message-agent")">
                    <strong>@(message.IsUser ? "You" : "AI Agent"):</strong>
                    <span>@message.Text</span>
                </div>
            }

            @if (_isSending)
            {
                <div class="ai-chat-message ai-chat-message-agent">
                    <strong>AI Agent:</strong>
                    <span><em>Thinking...</em></span>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }

        <div class="input-group">
            <input class="form-control"
                   type="text"
                   placeholder="Ask the AI Agent..."
                   @bind="_inputText"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   disabled="@_isSending" />
            <button class="btn btn-primary" type="button" @onclick="SendMessageAsync" disabled="@(_isSending || string.IsNullOrWhiteSpace(_inputText))">
                Send
            </button>
        </div>
    </div>
</div>

@code {
    private readonly List<AiChatMessage> _conversation = new();
    private string _inputText = string.Empty;
    private string? _errorMessage;
    private bool _isSending;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isSending && !string.IsNullOrWhiteSpace(_inputText))
        {
            await SendMessageAsync();
        }
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_inputText) || _isSending)
        {
            return;
        }

        _errorMessage = null;
        var userMessage = new AiChatMessage { IsUser = true, Text = _inputText.Trim() };
        _conversation.Add(userMessage);
        _inputText = string.Empty;
        _isSending = true;

        try
        {
            var response = await AIAdvisorService.SendMessageAsync(_conversation);
            _conversation.Add(response);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Something went wrong contacting the AI Agent: {ex.Message}";
        }
        finally
        {
            _isSending = false;
        }
    }
}
