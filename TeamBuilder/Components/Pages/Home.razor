@page "/"
@using Microsoft.AspNetCore.Components.Forms
@using TeamBuilder.Services.Services
@using TeamBuilder.Data.Models
@using TeamBuilder.Data.Responses
@inject CsvParserService CsvParserService
@inject HubApiService HubApiService
@inject RankingService RankingService

<PageTitle>Home</PageTitle>

<section id="steps">
	<p>Step 1. Download Poke Genie</p>
	<p>Step 2. Scan all your pokemon in Pokemon Go</p>
	<p>Step 3. Export your pokemon from Poke Genie to a csv</p>
	<p>Step 4. Upload your Pokémon export CSV to parse it into a typed list.</p>

	<div class="d-flex gap-2 align-items-center mb-3">
		<label for="pokemonCsvInput" class="btn btn-secondary mb-0 @((_isLoading || _isTierLoading) ? "disabled" : string.Empty)">
			@((_isLoading || _isTierLoading) ? "Processing" : "Upload CSV")
		</label>
		<InputFile id="pokemonCsvInput" class="d-none" OnChange="OnCsvSelected" accept=".csv" disabled="@(_isLoading || _isTierLoading)" />
	</div>

	@if (!string.IsNullOrWhiteSpace(_errorMessage))
	{
		<div class="alert alert-danger" role="alert">@_errorMessage</div>
	}
</section>

@if (!string.IsNullOrWhiteSpace(_hubErrorMessage))
{
	<div class="alert alert-warning" role="alert">@_hubErrorMessage</div>
}

@if (_isTierLoading || _tierProgressPercent > 0)
{
	<div class="mb-3 w-50" aria-live="polite">
		<div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@_tierProgressPercent">
			<div class="progress-bar @(_isTierLoading ? "progress-bar-striped progress-bar-animated" : string.Empty)"
				 style="width: @_tierProgressPercent%;">@_tierProgressPercent%</div>
		</div>
		<small class="text-muted">@_tierProgressMessage</small>
	</div>
}

@if (_allTierRows.Count > 0)
{
	<details class="mb-4">
		<summary class="fw-semibold">All Hub Tier Lists (@_allTierRows.Count entries)</summary>
		<p class="text-muted mt-2">Loaded @_allTierRows.Count ranked entries across all attacker types.</p>

		<div class="table-responsive">
			<table class="table table-striped table-sm">
				<thead>
					<tr>
						<th>Attacker Type</th>
						<th>Rank</th>
						<th>#</th>
						<th>Name</th>
						<th>Form</th>
						<th>Fast Attack</th>
						<th>Charged Attack</th>
						<th>DPS</th>
						<th>TDO</th>
						<th>Score</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var row in _allTierRows)
					{
						<tr>
							<td>@row.AttackerType</td>
							<td>@row.Pokemon.Rank</td>
							<td>@row.Pokemon.PokemonNumber</td>
							<td>@row.Pokemon.Name</td>
							<td>@row.Pokemon.Form</td>
							<td>@row.Pokemon.FastAttack</td>
							<td>@row.Pokemon.ChargedAttack</td>
							<td>@row.Pokemon.DPS</td>
							<td>@row.Pokemon.TDO</td>
							<td>@row.Pokemon.Score</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</details>
}

@if (_validationFailures.Count > 0)
{
	<div class="alert alert-warning" role="alert">
		Found @_validationFailures.Count validation issue(s). Invalid fields were set to null.
	</div>

	<details class="mb-3">
		<summary class="fw-semibold">CSV Validation Issues (showing up to 50)</summary>
		<div class="table-responsive mt-2">
			<table class="table table-sm table-bordered">
				<thead>
					<tr>
						<th>Row</th>
						<th>Column</th>
						<th>Value</th>
						<th>Issue</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var issue in _validationFailures.Take(50))
					{
						<tr>
							<td>@issue.RowNumber</td>
							<td>@issue.ColumnName</td>
							<td>@issue.RawValue</td>
							<td>@issue.Message</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</details>

	@if (_validationFailures.Count > 50)
	{
		<p class="text-muted">Showing first 50 validation issues.</p>
	}
}

@if (_pokemon.Count > 0)
{
	<details class="mb-3">
		<summary class="fw-semibold">Uploaded Pokémon (@_pokemon.Count)</summary>
		<div class="table-responsive mt-2">
			<table class="table table-striped table-sm">
				<thead>
					<tr>
						<th>Index</th>
						<th>#</th>
						<th>Name</th>
						<th>Form</th>
						<th>Gender</th>
						<th>CP</th>
						<th>HP</th>
						<th>Atk/Def/Sta IV</th>
						<th>Quick Move</th>
						<th>Charge Move</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var p in _pokemon)
					{
						<tr>
							<td>@p.Index</td>
							<td>@p.PokemonNumber</td>
							<td>@p.Name</td>
							<td>@p.Form</td>
							<td>@p.Gender</td>
							<td>@p.CP</td>
							<td>@p.HP</td>
							<td>@($"{p.AtkIV}/{p.DefIV}/{p.StaIV}")</td>
							<td>@p.QuickMove</td>
							<td>@p.ChargeMove</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</details>
}

@if (GetRaidTeamSections().Any(x => x.Team.Count > 0))
{
	<h2>Top 6 Owned Raid Teams</h2>
	@foreach (var section in GetRaidTeamSections().Where(x => x.Team.Count > 0))
	{
		<details class="mb-3">
			<summary class="fw-semibold">@section.Label Raid Team (@section.Team.Count)</summary>
			<div class="table-responsive mt-2">
				<table class="table table-striped table-sm">
					<thead>
						<tr>
							<th>#</th>
							<th>Name</th>
							<th>Form</th>
							<th>CP</th>
							<th>HP</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var p in section.Team)
						{
							<tr>
								<td>@p.PokemonNumber</td>
								<td>@p.Name</td>
								<td>@p.Form</td>
								<td>@p.CP</td>
								<td>@p.HP</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</details>
	}
}

@code {
	private const long MaxCsvSize = 10 * 1024 * 1024;

	private readonly List<Pokemon> _pokemon = [];
	private readonly List<CsvValidationFailure> _validationFailures = [];
	private readonly List<HubTierRow> _allTierRows = [];
	private RankingResponse _rankingResponse = new();
	private static readonly string[] _attackerTypes =
	[
		"normal", "fire", "water", "electric", "grass", "ice", "fighting", "poison",
		"ground", "flying", "psychic", "bug", "rock", "ghost", "dragon", "dark",
		"steel", "fairy"
	];
	private string? _uploadedFileName;
	private string? _errorMessage;
	private string? _hubErrorMessage;
	private string _tierProgressMessage = "Idle";
	private bool _isLoading;
	private bool _isTierLoading;
	private int _tierProgressPercent;

	private sealed class HubTierRow
	{
		public required string AttackerType { get; init; }
		public required HubRankedPokemon Pokemon { get; init; }
	}

	private sealed class RaidTeamSection
	{
		public required string Label { get; init; }
		public required IList<RankedPokemon> Team { get; init; }
	}

	private async Task<HubRankingResponse?> LoadAllTierListsAsync()
	{
		_hubErrorMessage = null;

		try
		{
			_isTierLoading = true;
			_tierProgressPercent = 0;
			_tierProgressMessage = "Preparing Hub tier list crawl...";
			_allTierRows.Clear();
			await InvokeAsync(StateHasChanged);

			var tierMap = new Dictionary<string, IList<HubRankedPokemon>>(StringComparer.OrdinalIgnoreCase);

			for (var i = 0; i < _attackerTypes.Length; i++)
			{
				var attackerType = _attackerTypes[i];
				_tierProgressMessage = $"Processing '{attackerType}' tier list ({i + 1}/{_attackerTypes.Length})...";
				await InvokeAsync(StateHasChanged);

				var tierList = await HubApiService.CrawlBestPerTypeAsync(attackerType, 200);
				tierMap[attackerType] = tierList;
				AddTierRows(attackerType, tierList);

				_tierProgressPercent = (int)Math.Round(((i + 1d) / _attackerTypes.Length) * 100d);
			}

			_tierProgressMessage = "Completed all tier lists.";

			_allTierRows.Sort((a, b) =>
			{
				var typeCompare = string.Compare(a.AttackerType, b.AttackerType, StringComparison.OrdinalIgnoreCase);
				if (typeCompare != 0)
				{
					return typeCompare;
				}

				return (a.Pokemon.Rank ?? int.MaxValue).CompareTo(b.Pokemon.Rank ?? int.MaxValue);
			});

			return new HubRankingResponse
			{
				NormalTierList = tierMap.GetValueOrDefault("normal") ?? [],
				FireTierList = tierMap.GetValueOrDefault("fire") ?? [],
				WaterTierList = tierMap.GetValueOrDefault("water") ?? [],
				ElectricTierList = tierMap.GetValueOrDefault("electric") ?? [],
				GrassTierList = tierMap.GetValueOrDefault("grass") ?? [],
				IceTierList = tierMap.GetValueOrDefault("ice") ?? [],
				FightingTierList = tierMap.GetValueOrDefault("fighting") ?? [],
				PoisonTierList = tierMap.GetValueOrDefault("poison") ?? [],
				GroundTierList = tierMap.GetValueOrDefault("ground") ?? [],
				FlyingTierList = tierMap.GetValueOrDefault("flying") ?? [],
				PsychicTierList = tierMap.GetValueOrDefault("psychic") ?? [],
				BugTierList = tierMap.GetValueOrDefault("bug") ?? [],
				RockTierList = tierMap.GetValueOrDefault("rock") ?? [],
				GhostTierList = tierMap.GetValueOrDefault("ghost") ?? [],
				DragonTierList = tierMap.GetValueOrDefault("dragon") ?? [],
				DarkTierList = tierMap.GetValueOrDefault("dark") ?? [],
				SteelTierList = tierMap.GetValueOrDefault("steel") ?? [],
				FairyTierList = tierMap.GetValueOrDefault("fairy") ?? []
			};
		}
		catch (Exception ex)
		{
			_hubErrorMessage = $"Failed to load Hub tier lists: {ex.Message}";
			_tierProgressMessage = "Stopped due to an error.";
			return null;
		}
		finally
		{
			_isTierLoading = false;
		}
	}

	private void AddTierRows(string attackerType, IEnumerable<HubRankedPokemon> tierList)
	{
		foreach (var pokemon in tierList)
		{
			_allTierRows.Add(new HubTierRow
			{
				AttackerType = attackerType,
				Pokemon = pokemon
			});
		}
	}

	private async Task OnCsvSelected(InputFileChangeEventArgs e)
	{
		_errorMessage = null;
		_hubErrorMessage = null;
		_pokemon.Clear();
		_validationFailures.Clear();
		_rankingResponse = new RankingResponse();

		try
		{
			_isLoading = true;
			var file = e.File;
			_uploadedFileName = file.Name;

			await using var stream = file.OpenReadStream(MaxCsvSize);
			var parseResult = await CsvParserService.ParsePokemonCsvAsync(stream);

			if (!string.IsNullOrWhiteSpace(parseResult.FatalError))
			{
				_errorMessage = parseResult.FatalError;
				return;
			}

			_pokemon.AddRange(parseResult.Pokemon);
			_validationFailures.AddRange(parseResult.ValidationFailures);

			if (_pokemon.Count == 0)
			{
				return;
			}

			var hubRanking = await LoadAllTierListsAsync();
			if (hubRanking is null)
			{
				return;
			}
			_rankingResponse = RankingService.BuildRankingResponse(_pokemon, hubRanking);

			if (!GetRaidTeamSections().Any(x => x.Team.Count > 0))
			{
				_hubErrorMessage = "No owned Pokémon were found in the current Hub tier lists.";
			}
		}
		catch (Exception ex)
		{
			_errorMessage = $"Failed to parse CSV: {ex.Message}";
		}
		finally
		{
			_isLoading = false;
		}
	}

	private IEnumerable<RaidTeamSection> GetRaidTeamSections()
	{
		return
		[
			new RaidTeamSection { Label = "Normal", Team = _rankingResponse.NormalRaidTeam },
			new RaidTeamSection { Label = "Fire", Team = _rankingResponse.FireRaidTeam },
			new RaidTeamSection { Label = "Water", Team = _rankingResponse.WaterRaidTeam },
			new RaidTeamSection { Label = "Electric", Team = _rankingResponse.ElectricRaidTeam },
			new RaidTeamSection { Label = "Grass", Team = _rankingResponse.GrassRaidTeam },
			new RaidTeamSection { Label = "Ice", Team = _rankingResponse.IceRaidTeam },
			new RaidTeamSection { Label = "Fighting", Team = _rankingResponse.FightingRaidTeam },
			new RaidTeamSection { Label = "Poison", Team = _rankingResponse.PoisonRaidTeam },
			new RaidTeamSection { Label = "Ground", Team = _rankingResponse.GroundRaidTeam },
			new RaidTeamSection { Label = "Flying", Team = _rankingResponse.FlyingRaidTeam },
			new RaidTeamSection { Label = "Psychic", Team = _rankingResponse.PsychicRaidTeam },
			new RaidTeamSection { Label = "Bug", Team = _rankingResponse.BugRaidTeam },
			new RaidTeamSection { Label = "Rock", Team = _rankingResponse.RockRaidTeam },
			new RaidTeamSection { Label = "Ghost", Team = _rankingResponse.GhostRaidTeam },
			new RaidTeamSection { Label = "Dragon", Team = _rankingResponse.DragonRaidTeam },
			new RaidTeamSection { Label = "Dark", Team = _rankingResponse.DarkRaidTeam },
			new RaidTeamSection { Label = "Steel", Team = _rankingResponse.SteelRaidTeam },
			new RaidTeamSection { Label = "Fairy", Team = _rankingResponse.FairyRaidTeam }
		];
	}

}
