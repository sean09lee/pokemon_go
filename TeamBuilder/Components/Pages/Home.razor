@page "/"
@using Microsoft.AspNetCore.Components.Forms
@using TeamBuilder.Services.Services
@using TeamBuilder.Services.Contracts
@using TeamBuilder.Data.Models
@using TeamBuilder.Data.Responses
@inject CsvParserService CsvParserService
@inject IHubApiService HubApiService
@inject IRankingService RankingService
@inject PokemonUploadState UploadState
@using TeamBuilder.Components.Shared

<PageTitle>Home</PageTitle>

@{
	var raidSections = GetRaidTeamTypeSections().ToList();
	var selectedRaidType = EnsureSelectedRaidTeamType(raidSections);
	var selectedSidebar = EnsureSelectedSidebarSection(raidSections);
	var hasActiveRaid = selectedSidebar.StartsWith(RaidSectionPrefix, StringComparison.OrdinalIgnoreCase);
	var activeRaidSection = hasActiveRaid
		? raidSections.FirstOrDefault(x => BuildRaidSectionKey(x.TypeKey) == selectedSidebar)
		: default;
	var selectedTab = hasActiveRaid && activeRaidSection.TypeKey is not null
		? GetSelectedRaidTeamTab(activeRaidSection.TypeKey)
		: "noInvestment";
	var selectedTeam = hasActiveRaid && activeRaidSection.TypeKey is not null
		? GetTeamForTab(activeRaidSection.Variants, selectedTab)
		: [];
}

<div class="tb-raid-page-shell">
	<section class="tb-raid-main">
		@if (ShowRaidSidebar)
		{
			<div class="tb-raid-nav-pills">
			<button type="button"
					class="tb-sidebar-link @(selectedSidebar == UploadSectionKey ? "active" : string.Empty)"
					@onclick='@(() => SelectSidebarSection(UploadSectionKey))'>
				Upload
			</button>
			<button type="button"
					class="tb-sidebar-link @(selectedSidebar == HubSectionKey ? "active" : string.Empty)"
					disabled="@(!ShowRaidSidebar)"
					@onclick='@(() => SelectSidebarSection(HubSectionKey))'>
				Hub Tier Lists
			</button>
			<button type="button"
					class="tb-sidebar-link @(selectedSidebar == PokemonSectionKey ? "active" : string.Empty)"
					disabled="@(!ShowRaidSidebar)"
					@onclick='@(() => SelectSidebarSection(PokemonSectionKey))'>
				Your Pokemon
			</button>

			@if (raidSections.Count > 0)
			{
				<span class="tb-sidebar-group-title">Raid Teams</span>
				@foreach (var section in raidSections)
				{
					var sectionKey = BuildRaidSectionKey(section.TypeKey);
					<button type="button"
							class="tb-sidebar-link @(selectedSidebar == sectionKey ? "active" : string.Empty)"
							disabled="@(!ShowRaidSidebar)"
							@onclick='@(() => SelectRaidSidebar(section.TypeKey))'>
						@section.Label
					</button>
				}
			}
		</div>
		}

		@if (selectedSidebar == UploadSectionKey)
		{
			<div class="tb-home-shell">
				<div class="tb-eyebrow-row">
					<span class="tb-eyebrow-icon" aria-hidden="true"><LucideIcon Name="circle-gauge" Size="14" /></span>
					<span class="tb-eyebrow-text">RAID BUILDER</span>
					<span class="tb-eyebrow-rule"></span>
				</div>

								<section class="tb-upload-card mb-3">
									<h1 class="tb-hero-title">Build your best <span class="tb-hero-highlight">raid team</span>.</h1>
									<p class="tb-hero-subtitle">Upload a Poké Genie CSV to generate the strongest raid team from your roster and resources.</p>

										<div class="tb-upload-card-header">
											<span class="tb-upload-card-icon" aria-hidden="true"><LucideIcon Name="file" Size="20" /></span>
											<div class="tb-upload-card-heading">
												<h2 class="tb-upload-card-title">Upload your Poké Genie CSV</h2>
												<p class="tb-upload-card-subtitle">Drag and drop your CSV file here, or choose a file to get started.</p>
											</div>
											<button type="button" class="tb-settings-btn" @onclick="@(() => _showSettings = !_showSettings)">
												<span aria-hidden="true"><LucideIcon Name="settings" Size="16" /></span> Settings
											</button>
										</div>

										@if (_showSettings)
										{
											<div class="tb-settings-panel">
												<label for="dustLimitInput" class="form-label">Stardust limit</label>
												<input id="dustLimitInput" class="form-control" type="number" min="0" step="100"
													   @bind="_dustLimit" @bind:event="oninput" disabled="@(_isLoading || _isTierLoading)" />
											</div>
										}

										<label for="pokemonCsvInput" class="tb-dropzone @((_isLoading || _isTierLoading) ? "disabled" : string.Empty)">
											<span class="tb-dropzone-icon" aria-hidden="true"><LucideIcon Name="cloud-upload" Size="28" /></span>
											@if (_isLoading || _isTierLoading)
											{
												<span class="tb-dropzone-text">Processing...</span>
											}
											else
											{
												<span class="tb-dropzone-text">Drag and drop your Poké Genie CSV here</span>
												<span class="tb-dropzone-or">or</span>
												<span class="btn btn-primary tb-dropzone-btn">Choose File</span>
											}
											<span class="tb-dropzone-hint">Supports .csv files exported from Poké Genie.</span>
										</label>
										<InputFile id="pokemonCsvInput" class="d-none" OnChange="OnCsvSelected" accept=".csv" disabled="@(_isLoading || _isTierLoading)" />

										@if (!string.IsNullOrWhiteSpace(_errorMessage))
					{
						<div class="alert alert-danger mt-3 mb-0" role="alert">@_errorMessage</div>
					}
				</section>

				<section class="tb-how-it-works mb-3">
					<h3 class="tb-section-label">How it works</h3>
					<div class="tb-steps-row">
						<div class="tb-step">
							<span class="tb-step-badge">1</span>
							<span class="tb-step-icon" aria-hidden="true"><LucideIcon Name="smartphone" Size="18" /></span>
							<div class="tb-step-copy">
								<div class="tb-step-title">Download Poke Genie</div>
								<div class="tb-step-subtitle">Get the app on your phone.</div>
							</div>
						</div>
						<span class="tb-step-chevron" aria-hidden="true"><LucideIcon Name="chevron-right" Size="18" /></span>
						<div class="tb-step">
							<span class="tb-step-badge">2</span>
							<span class="tb-step-icon" aria-hidden="true"><LucideIcon Name="file-up" Size="18" /></span>
							<div class="tb-step-copy">
								<div class="tb-step-title">Export CSV</div>
								<div class="tb-step-subtitle">Export your Pokémon data as a CSV file.</div>
							</div>
						</div>
						<span class="tb-step-chevron" aria-hidden="true"><LucideIcon Name="chevron-right" Size="18" /></span>
						<div class="tb-step">
							<span class="tb-step-badge">3</span>
							<span class="tb-step-icon" aria-hidden="true"><LucideIcon Name="upload" Size="18" /></span>
							<div class="tb-step-copy">
								<div class="tb-step-title">Upload File</div>
								<div class="tb-step-subtitle">Upload your CSV to this tool.</div>
							</div>
						</div>
						<span class="tb-step-chevron" aria-hidden="true"><LucideIcon Name="chevron-right" Size="18" /></span>
						<div class="tb-step">
							<span class="tb-step-badge">4</span>
							<span class="tb-step-icon" aria-hidden="true"><LucideIcon Name="chart-no-axes-column-increasing" Size="18" /></span>
							<div class="tb-step-copy">
								<div class="tb-step-title">Get Your Best Team</div>
								<div class="tb-step-subtitle">We'll analyze your roster and resources.</div>
							</div>
						</div>
					</div>
				</section>

				@if (_pokemon.Count == 0 && !_isLoading && !_isTierLoading)
				{
					<div class="tb-locked-bar">
						<span class="tb-locked-icon" aria-hidden="true"><LucideIcon Name="lock-keyhole" Size="18" /></span>
						<span>Upload your CSV to unlock My Pokémon and personalized team recommendations.</span>
					</div>
				}

				@if (!string.IsNullOrWhiteSpace(_hubErrorMessage))
				{
					<div class="alert alert-warning tb-home-alert" role="alert">@_hubErrorMessage</div>
				}

				@if (_isTierLoading || (_tierProgressPercent > 0 && !_tierProgressHalted))
				{
					<div class="tb-progress-card mb-3" aria-live="polite">
						<div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@_tierProgressPercent">
							<div class="progress-bar @(_isTierLoading ? "progress-bar-striped progress-bar-animated" : string.Empty)"
								 style="width: @_tierProgressPercent%;">@_tierProgressPercent%</div>
						</div>
						<small class="text-muted">@_tierProgressMessage</small>
					</div>
				}

				@if (_tierProgressHalted)
				{
					<div class="alert alert-danger tb-home-alert" role="alert">
						<strong>Processing stopped.</strong>
						@if (!string.IsNullOrWhiteSpace(_tierProgressMessage))
						{
							<span> @_tierProgressMessage</span>
						}
					</div>
				}

				@if (_candyQuestions.Count > 0)
				{
					<div class="card mb-3 tb-content-card">
						<div class="card-body">
							<h5 class="card-title mb-2">Candy Questions</h5>
							<p class="text-muted mb-3">Answer these to continue team generation.</p>
							@foreach (var question in _candyQuestions.Values.OrderBy(x => x.IsSubmitted).ThenBy(x => x.PokemonNumber))
							{
								<div class="d-flex align-items-end gap-2 mb-2">
									<div class="flex-grow-1">
										<label class="form-label mb-1">How much @question.DisplayName candy do you have?</label>
										<input class="form-control" type="text" inputmode="numeric" pattern="[0-9]*"
											   @bind="question.InputValue" @bind:event="oninput" onfocus="this.select();" />
									</div>
									<button class="btn btn-primary" @onclick="() => SubmitCandyQuestion(question)">@(question.IsSubmitted ? "Update" : "Submit")</button>
								</div>
							}

							@if (ShowRaidSidebar && _pokemon.Count > 0)
							{
								<div class="d-flex justify-content-end mt-2">
									<button class="btn btn-outline-light" @onclick="RecalculateRaidTeamsAsync" disabled="@(_isLoading || _isTierLoading)">
										Recalculate Teams
									</button>
								</div>
							}
						</div>
					</div>
				}
			</div>
		}
		else if (selectedSidebar == HubSectionKey)
		{
			<h2 class="tb-section-title">Hub Tier Lists</h2>
			@if (_allTierRows.Count == 0)
			{
				<p class="text-muted">Upload and process a CSV to load Hub tier lists.</p>
			}
			else
			{
				<p class="text-muted mt-2">Loaded @_allTierRows.Count ranked entries across all attacker types.</p>
				@foreach (var section in GetHubTierSections())
				{
					<details class="mb-3" open>
						<summary class="fw-semibold">@section.Label Tier List (@section.TierList.Count entries)</summary>
						<div class="table-responsive mt-2">
							<table class="table table-striped table-sm">
								<thead>
									<tr>
										<th>Rank</th>
										<th>#</th>
										<th>Name</th>
										<th>Form</th>
										<th>Fast Attack</th>
										<th>Charged Attack</th>
										<th>DPS</th>
										<th>TDO</th>
										<th>Score</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var pokemon in section.TierList)
									{
										<tr>
											<td>@pokemon.Rank</td>
											<td>@pokemon.PokemonNumber</td>
											<td>@pokemon.Name</td>
											<td>@pokemon.Form</td>
											<td>@pokemon.FastAttack</td>
											<td>@pokemon.ChargedAttack</td>
											<td>@pokemon.DPS</td>
											<td>@pokemon.TDO</td>
											<td>@pokemon.Score</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</details>
				}
			}
		}
		else if (selectedSidebar == PokemonSectionKey)
		{
			<h2 class="tb-section-title">Your Pokemon</h2>
			@if (_validationFailures.Count > 0)
			{
				<div class="alert alert-warning" role="alert">
					Found @_validationFailures.Count validation issue(s). Invalid fields were set to null.
				</div>

				<details class="mb-3" open>
					<summary class="fw-semibold">CSV Validation Issues (showing up to 50)</summary>
					<div class="table-responsive mt-2">
						<table class="table table-sm table-bordered">
							<thead>
								<tr>
									<th>Row</th>
									<th>Column</th>
									<th>Value</th>
									<th>Issue</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var issue in _validationFailures.Take(50))
								{
									<tr>
										<td>@issue.RowNumber</td>
										<td>@issue.ColumnName</td>
										<td>@issue.RawValue</td>
										<td>@issue.Message</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</details>

				@if (_validationFailures.Count > 50)
				{
					<p class="text-muted">Showing first 50 validation issues.</p>
				}
			}

			@if (_pokemon.Count == 0)
			{
				<p class="text-muted">Upload a CSV to view your Pokémon list.</p>
			}
			else
			{
				<details class="mb-3" open>
					<summary class="fw-semibold">Uploaded Pokémon (@_pokemon.Count)</summary>
					<div class="table-responsive mt-2">
						<table class="table table-striped table-sm">
							<thead>
								<tr>
									<th>Index</th>
									<th>#</th>
									<th>Name</th>
									<th>Form</th>
									<th>Gender</th>
									<th>CP</th>
									<th>HP</th>
									<th>Atk/Def/Sta IV</th>
									<th>Quick Move</th>
									<th>Charge Move</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var p in _pokemon)
								{
									<tr>
										<td>@p.Index</td>
										<td>@p.PokemonNumber</td>
										<td>@p.Name</td>
										<td>@p.Form</td>
										<td>@p.Gender</td>
										<td>@p.CP</td>
										<td>@p.HP</td>
										<td>@($"{p.AtkIV}/{p.DefIV}/{p.StaIV}")</td>
										<td>@p.QuickMove</td>
										<td>@p.ChargeMove</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</details>
			}
		}
		else if (hasActiveRaid && activeRaidSection.TypeKey is not null)
		{
			<h2 class="tb-section-title">Your Raid Teams</h2>
			<div class="tb-raid-header">
				<h3 class="mb-0">@activeRaidSection.Label Team</h3>
				<span class="tb-raid-count">@selectedTeam.Count / 6</span>
			</div>

			<div class="tb-raid-tabs mt-2 mb-2" role="tablist">
				<button type="button"
						class="tb-raid-tab @(selectedTab == "noInvestment" ? "active" : string.Empty)"
						@onclick='@(() => SelectRaidTeamTab(activeRaidSection.TypeKey, "noInvestment"))'>
					No Investment
				</button>
				<button type="button"
						class="tb-raid-tab @(selectedTab == "currentResources" ? "active" : string.Empty)"
						@onclick='@(() => SelectRaidTeamTab(activeRaidSection.TypeKey, "currentResources"))'>
					Current Resources
				</button>
				<button type="button"
						class="tb-raid-tab @(selectedTab == "unlimitedResources" ? "active" : string.Empty)"
						@onclick='@(() => SelectRaidTeamTab(activeRaidSection.TypeKey, "unlimitedResources"))'>
					Unlimited Resources
				</button>
			</div>

			<div class="table-responsive mt-2">
				<table class="table table-striped table-sm tb-raid-table">
					<thead>
						<tr>
							<th>#</th>
							<th>Name</th>
							<th>Form</th>
							<th>CP</th>
							<th>HP</th>
							<th>Rank</th>
							<th>Ranked Target</th>
							<th>Candy to Lv30</th>
							<th>Dust to Lv30</th>
							<th>Mega/Primal Energy</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var p in selectedTeam)
						{
							<tr>
								<td>@p.PokemonNumber</td>
								<td>@p.Name</td>
								<td>@p.Form</td>
								<td>@p.CP</td>
								<td>@p.HP</td>
								<td>@p.Index</td>
								<td>@GetRankedTargetDisplay(p)</td>
								<td>@FormatNullableCost(p.TotalRequiredCandy)</td>
								<td>@FormatNullableCost(p.RequiredDustToLevel30)</td>
								<td>@FormatNullableCost(p.RequiredFirstTimeMegaEnergy)</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>

	<aside class="tb-ai-sidebar">
		<AiAgentPanel />
	</aside>
</div>

@code {
	private const long MaxCsvSize = 10 * 1024 * 1024;

	private readonly List<Pokemon> _pokemon = [];
	private readonly List<CsvValidationFailure> _validationFailures = [];
	private readonly List<HubTierRow> _allTierRows = [];
	private RankingResponse _rankingResponse = new();
	private readonly Dictionary<int, CandyQuestionState> _candyQuestions = [];
	private static readonly string[] _attackerTypes =
	[
		"normal", "fire", "water", "electric", "grass", "ice", "fighting", "poison",
		"ground", "flying", "psychic", "bug", "rock", "ghost", "dragon", "dark",
		"steel", "fairy"
	];
	private string? _uploadedFileName;
	private string? _errorMessage;
	private string? _hubErrorMessage;
	private string _tierProgressMessage = "Idle";
	private readonly Dictionary<int, int> _candyByPokemonNumber = [];
	private readonly Dictionary<string, string> _selectedRaidTeamTabByType = new(StringComparer.OrdinalIgnoreCase);
	private string? _selectedRaidTeamType;
	private string _selectedSidebarSection = UploadSectionKey;
	private bool _isLoading;
	private bool _isTierLoading;
	private int _tierProgressPercent;
	private bool _tierProgressHalted;
	private CancellationTokenSource? _processingCts;
	private int _dustLimit = 100000;
	private bool _showSettings;

	private const string UploadSectionKey = "upload";
	private const string HubSectionKey = "hub";
	private const string PokemonSectionKey = "pokemon";
	private const string RaidSectionPrefix = "raid:";

	private bool ShowRaidSidebar => !_isLoading && !_isTierLoading && _tierProgressPercent >= 100;

	private async Task<HubRankingResponse?> LoadAllTierListsAsync(CancellationToken cancellationToken)
	{
		_hubErrorMessage = null;

		try
		{
			cancellationToken.ThrowIfCancellationRequested();
			_isTierLoading = true;
			_tierProgressHalted = false;
			_tierProgressPercent = 0;
			_tierProgressMessage = "Preparing Hub tier list crawl...";
			_allTierRows.Clear();
			await InvokeAsync(StateHasChanged);

			var tierMap = new Dictionary<string, IList<HubRankedPokemon>>(StringComparer.OrdinalIgnoreCase);

			for (var i = 0; i < _attackerTypes.Length; i++)
			{
				cancellationToken.ThrowIfCancellationRequested();
				var attackerType = _attackerTypes[i];
				_tierProgressMessage = $"Processing '{attackerType}' tier list ({i + 1}/{_attackerTypes.Length})...";
				await InvokeAsync(StateHasChanged);

				using var perTypeCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
				perTypeCts.CancelAfter(TimeSpan.FromSeconds(120));

				var tierList = await HubApiService.CrawlBestPerTypeAsync(attackerType, 200, perTypeCts.Token);
				tierMap[attackerType] = tierList;
				AddTierRows(attackerType, tierList);

				_tierProgressPercent = (int)Math.Round(((i + 1d) / _attackerTypes.Length) * 60d);
			}

			_tierProgressPercent = 60;
			_tierProgressMessage = "Tier lists loaded. Building raid teams...";

			_allTierRows.Sort((a, b) =>
			{
				var typeCompare = string.Compare(a.AttackerType, b.AttackerType, StringComparison.OrdinalIgnoreCase);
				if (typeCompare != 0)
				{
					return typeCompare;
				}

				return (a.Pokemon.Rank ?? int.MaxValue).CompareTo(b.Pokemon.Rank ?? int.MaxValue);
			});

			return new HubRankingResponse
			{
				NormalTierList = tierMap.GetValueOrDefault("normal") ?? [],
				FireTierList = tierMap.GetValueOrDefault("fire") ?? [],
				WaterTierList = tierMap.GetValueOrDefault("water") ?? [],
				ElectricTierList = tierMap.GetValueOrDefault("electric") ?? [],
				GrassTierList = tierMap.GetValueOrDefault("grass") ?? [],
				IceTierList = tierMap.GetValueOrDefault("ice") ?? [],
				FightingTierList = tierMap.GetValueOrDefault("fighting") ?? [],
				PoisonTierList = tierMap.GetValueOrDefault("poison") ?? [],
				GroundTierList = tierMap.GetValueOrDefault("ground") ?? [],
				FlyingTierList = tierMap.GetValueOrDefault("flying") ?? [],
				PsychicTierList = tierMap.GetValueOrDefault("psychic") ?? [],
				BugTierList = tierMap.GetValueOrDefault("bug") ?? [],
				RockTierList = tierMap.GetValueOrDefault("rock") ?? [],
				GhostTierList = tierMap.GetValueOrDefault("ghost") ?? [],
				DragonTierList = tierMap.GetValueOrDefault("dragon") ?? [],
				DarkTierList = tierMap.GetValueOrDefault("dark") ?? [],
				SteelTierList = tierMap.GetValueOrDefault("steel") ?? [],
				FairyTierList = tierMap.GetValueOrDefault("fairy") ?? []
			};
		}
		catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
		{
			_hubErrorMessage = "Tier-list loading was canceled.";
			HaltProgress("Tier-list loading was canceled.");
			return null;
		}
		catch (OperationCanceledException)
		{
			_hubErrorMessage = "Tier-list loading timed out while waiting for Hub data.";
			HaltProgress("A Hub request timed out. Please try again.");
			return null;
		}
		catch (Exception ex)
		{
			_hubErrorMessage = $"Failed to load Hub tier lists: {ex.Message}";
			HaltProgress("Stopped due to an error while loading Hub tier lists.");
			return null;
		}
		finally
		{
			// keep spinner active through raid-team generation
		}
	}

	private void AddTierRows(string attackerType, IEnumerable<HubRankedPokemon> tierList)
	{
		foreach (var pokemon in tierList)
		{
			_allTierRows.Add(new HubTierRow
			{
				AttackerType = attackerType,
				Pokemon = pokemon
			});
		}
	}

	private IEnumerable<HubTierSection> GetHubTierSections()
	{
		foreach (var attackerType in _attackerTypes)
		{
			var tierList = _allTierRows
				.Where(x => string.Equals(x.AttackerType, attackerType, StringComparison.OrdinalIgnoreCase))
				.Select(x => x.Pokemon)
				.ToList();

			if (tierList.Count == 0)
			{
				continue;
			}

			yield return new HubTierSection
			{
				Label = char.ToUpperInvariant(attackerType[0]) + attackerType[1..],
				TierList = tierList
			};
		}
	}

	private async Task OnCsvSelected(InputFileChangeEventArgs e)
	{
		_processingCts?.Cancel();
		_processingCts?.Dispose();
		_processingCts = new CancellationTokenSource(TimeSpan.FromMinutes(8));
		var cancellationToken = _processingCts.Token;

		_errorMessage = null;
		_hubErrorMessage = null;
		_tierProgressHalted = false;
		_pokemon.Clear();
		_validationFailures.Clear();
		_rankingResponse = new RankingResponse();
		_candyQuestions.Clear();
		_selectedRaidTeamTabByType.Clear();
		_selectedRaidTeamType = null;
		_selectedSidebarSection = UploadSectionKey;

		try
		{
			cancellationToken.ThrowIfCancellationRequested();
			_isLoading = true;
			_isTierLoading = true;
			_tierProgressPercent = 0;
			_tierProgressMessage = "Starting...";
			var file = e.File;
			_uploadedFileName = file.Name;

			await using var stream = file.OpenReadStream(MaxCsvSize, cancellationToken);
			var parseResult = await CsvParserService.ParsePokemonCsvAsync(stream, cancellationToken);

			if (!string.IsNullOrWhiteSpace(parseResult.FatalError))
			{
				_errorMessage = parseResult.FatalError;
				HaltProgress("CSV processing stopped because the uploaded file could not be parsed.");
				return;
			}

			_pokemon.AddRange(parseResult.Pokemon);
			_validationFailures.AddRange(parseResult.ValidationFailures);

			if (_pokemon.Count == 0)
			{
				HaltProgress("CSV processing stopped because no Pokémon rows were found.");
				return;
			}

			UploadState.MarkUploaded();

			var hubRanking = await LoadAllTierListsAsync(cancellationToken);
			if (hubRanking is null)
			{
				return;
			}
			_rankingResponse = await RankingService.BuildRankingResponseAsync(
				_pokemon,
				hubRanking,
				_dustLimit,
				_candyByPokemonNumber,
				PromptCandyAmountAsync,
				ReportRankingProgressAsync,
				cancellationToken);

			_tierProgressPercent = 100;
			_tierProgressMessage = "Completed raid team generation.";

			if (!GetRaidTeamTypeSections().Any())
			{
				_hubErrorMessage = "No owned Pokémon were found in the current Hub tier lists.";
			}
		}
		catch (OperationCanceledException) when (_processingCts?.IsCancellationRequested == true)
		{
			_errorMessage = "Processing timed out. Please try again.";
			HaltProgress("Processing timed out before completion.");
		}
		catch (OperationCanceledException)
		{
			_errorMessage = "Processing was canceled.";
			HaltProgress("Processing was canceled.");
		}
		catch (Exception ex)
		{
			_errorMessage = $"Failed to parse CSV: {ex.Message}";
			HaltProgress("Processing stopped due to an unexpected error.");
		}
		finally
		{
			_isLoading = false;
			_isTierLoading = false;
			_processingCts?.Dispose();
			_processingCts = null;
		}
	}

	private async Task<int> PromptCandyAmountAsync(int pokemonNumber, string? pokemonName, CancellationToken cancellationToken)
	{
		if (_candyByPokemonNumber.TryGetValue(pokemonNumber, out var existing))
		{
			return existing;
		}

		var displayName = string.IsNullOrWhiteSpace(pokemonName) ? $"#{pokemonNumber}" : pokemonName;
		var question = _candyQuestions.GetValueOrDefault(pokemonNumber);
		if (question is null)
		{
			question = new CandyQuestionState
			{
				PokemonNumber = pokemonNumber,
				DisplayName = displayName
			};
			_candyQuestions[pokemonNumber] = question;
			_tierProgressMessage = $"Waiting for candy input: {displayName}";
			await InvokeAsync(StateHasChanged);
		}

		using var registration = cancellationToken.Register(() => question.Completion.TrySetCanceled(cancellationToken));
		var candy = await question.Completion.Task;
		_candyByPokemonNumber[pokemonNumber] = candy;
		return candy;
	}

	private void SubmitCandyQuestion(CandyQuestionState question)
	{
		if (!int.TryParse(question.InputValue, out var candy) || candy < 0)
		{
			candy = 0;
		}

		question.IsSubmitted = true;
		_candyByPokemonNumber[question.PokemonNumber] = candy;
		question.Completion.TrySetResult(candy);
	}

	private async Task RecalculateRaidTeamsAsync()
	{
		if (_pokemon.Count == 0)
		{
			return;
		}

		_processingCts?.Cancel();
		_processingCts?.Dispose();
		_processingCts = new CancellationTokenSource(TimeSpan.FromMinutes(5));
		var cancellationToken = _processingCts.Token;

		try
		{
			cancellationToken.ThrowIfCancellationRequested();
			_hubErrorMessage = null;
			_tierProgressHalted = false;
			_isTierLoading = true;
			_tierProgressPercent = Math.Max(60, _tierProgressPercent);
			_tierProgressMessage = "Recalculating raid teams with updated candy...";

			var hubRanking = BuildHubRankingResponseFromCachedRows() ?? await LoadAllTierListsAsync(cancellationToken);
			if (hubRanking is null)
			{
				return;
			}

			_rankingResponse = await RankingService.BuildRankingResponseAsync(
				_pokemon,
				hubRanking,
				_dustLimit,
				_candyByPokemonNumber,
				PromptCandyAmountAsync,
				ReportRankingProgressAsync,
				cancellationToken);

			_tierProgressPercent = 100;
			_tierProgressMessage = "Completed raid team generation.";
		}
		catch (OperationCanceledException) when (_processingCts?.IsCancellationRequested == true)
		{
			_errorMessage = "Recalculation timed out. Please try again.";
			HaltProgress("Recalculation timed out before completion.");
		}
		catch (OperationCanceledException)
		{
			_errorMessage = "Recalculation was canceled.";
			HaltProgress("Recalculation was canceled.");
		}
		catch (Exception ex)
		{
			_errorMessage = $"Failed to recalculate teams: {ex.Message}";
			HaltProgress("Recalculation stopped due to an unexpected error.");
		}
		finally
		{
			_isTierLoading = false;
			_processingCts?.Dispose();
			_processingCts = null;
		}
	}

	private void HaltProgress(string message)
	{
		_tierProgressHalted = true;
		_tierProgressPercent = 0;
		_tierProgressMessage = message;
	}

	private HubRankingResponse? BuildHubRankingResponseFromCachedRows()
	{
		if (_allTierRows.Count == 0)
		{
			return null;
		}

		IList<HubRankedPokemon> ForType(string typeKey)
			=> _allTierRows
				.Where(x => string.Equals(x.AttackerType, typeKey, StringComparison.OrdinalIgnoreCase))
				.Select(x => x.Pokemon)
				.ToList();

		return new HubRankingResponse
		{
			NormalTierList = ForType("normal"),
			FireTierList = ForType("fire"),
			WaterTierList = ForType("water"),
			ElectricTierList = ForType("electric"),
			GrassTierList = ForType("grass"),
			IceTierList = ForType("ice"),
			FightingTierList = ForType("fighting"),
			PoisonTierList = ForType("poison"),
			GroundTierList = ForType("ground"),
			FlyingTierList = ForType("flying"),
			PsychicTierList = ForType("psychic"),
			BugTierList = ForType("bug"),
			RockTierList = ForType("rock"),
			GhostTierList = ForType("ghost"),
			DragonTierList = ForType("dragon"),
			DarkTierList = ForType("dark"),
			SteelTierList = ForType("steel"),
			FairyTierList = ForType("fairy")
		};
	}

	private async Task ReportRankingProgressAsync(string stageMessage, int rankingPercent)
	{
		var bounded = Math.Max(0, Math.Min(100, rankingPercent));
		_tierProgressPercent = 60 + (int)Math.Round(bounded * 0.4d);
		_tierProgressMessage = stageMessage;
		await InvokeAsync(StateHasChanged);
	}

	private static string FormatNullableCost(int? value)
	{
		return value is null or <= 0 ? "-" : value.Value.ToString();
	}

	private static string GetRankedTargetDisplay(RankedPokemon pokemon)
	{
		if (string.IsNullOrWhiteSpace(pokemon.EvolvedName))
		{
			return pokemon.Name ?? "-";
		}

		if (string.IsNullOrWhiteSpace(pokemon.EvolvedForm)
			|| string.Equals(pokemon.EvolvedForm, "normal", StringComparison.OrdinalIgnoreCase))
		{
			return pokemon.EvolvedName;
		}

		return $"{pokemon.EvolvedName} ({pokemon.EvolvedForm})";
	}

	private IEnumerable<(string TypeKey, string Label, RaidTeamVariantResult Variants)> GetRaidTeamTypeSections()
	{
		foreach (var attackerType in _attackerTypes)
		{
			if (!_rankingResponse.RaidTeamsByType.TryGetValue(attackerType, out var variants))
			{
				continue;
			}

			if (variants.NoInvestmentTeam.Count == 0
				&& variants.CurrentResourcesTeam.Count == 0
				&& variants.UnlimitedResourcesTeam.Count == 0)
			{
				continue;
			}

			var label = char.ToUpperInvariant(attackerType[0]) + attackerType[1..];
			yield return (attackerType, label, variants);
		}
	}

	private string GetSelectedRaidTeamTab(string attackerType)
	{
		if (_selectedRaidTeamTabByType.TryGetValue(attackerType, out var tab))
		{
			return tab;
		}

		_selectedRaidTeamTabByType[attackerType] = "noInvestment";
		return "noInvestment";
	}

	private void SelectRaidTeamTab(string attackerType, string tab)
	{
		_selectedRaidTeamTabByType[attackerType] = tab;
	}

	private string EnsureSelectedRaidTeamType(IList<(string TypeKey, string Label, RaidTeamVariantResult Variants)> sections)
	{
		if (sections.Count == 0)
		{
			_selectedRaidTeamType = null;
			return string.Empty;
		}

		if (_selectedRaidTeamType is not null && sections.Any(x => x.TypeKey == _selectedRaidTeamType))
		{
			return _selectedRaidTeamType;
		}

		_selectedRaidTeamType = sections[0].TypeKey;
		return _selectedRaidTeamType;
	}

	private void SelectRaidTeamType(string attackerType)
	{
		_selectedRaidTeamType = attackerType;
	}

	private static string BuildRaidSectionKey(string attackerType) => $"{RaidSectionPrefix}{attackerType}";

	private string EnsureSelectedSidebarSection(IList<(string TypeKey, string Label, RaidTeamVariantResult Variants)> sections)
	{
		if (_selectedSidebarSection.StartsWith(RaidSectionPrefix, StringComparison.OrdinalIgnoreCase))
		{
			if (!sections.Any(x => string.Equals(BuildRaidSectionKey(x.TypeKey), _selectedSidebarSection, StringComparison.OrdinalIgnoreCase)))
			{
				_selectedSidebarSection = UploadSectionKey;
			}
		}

		return _selectedSidebarSection;
	}

	private void SelectSidebarSection(string sectionKey)
	{
		if (!ShowRaidSidebar && sectionKey != UploadSectionKey)
		{
			return;
		}

		_selectedSidebarSection = sectionKey;
	}

	private void SelectRaidSidebar(string attackerType)
	{
		if (!ShowRaidSidebar)
		{
			return;
		}

		_selectedRaidTeamType = attackerType;
		_selectedSidebarSection = BuildRaidSectionKey(attackerType);
	}

	private static IList<RankedPokemon> GetTeamForTab(RaidTeamVariantResult variants, string tab)
	{
		return tab switch
		{
			"currentResources" => variants.CurrentResourcesTeam,
			"unlimitedResources" => variants.UnlimitedResourcesTeam,
			_ => variants.NoInvestmentTeam
		};
	}

}
