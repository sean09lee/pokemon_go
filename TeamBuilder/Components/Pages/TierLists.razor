@page "/tier-lists"
@using TeamBuilder.Data.Models
@using TeamBuilder.Services.Contracts
@inject IHubApiService HubApiService

<PageTitle>Tier Lists</PageTitle>

<div class="tl-main">
    <div class="tb-eyebrow-row">
        <span class="tb-eyebrow-icon" aria-hidden="true"><LucideIcon Name="chart-no-axes-column-increasing" Size="14" /></span>
        <span class="tb-eyebrow-text">TIER LISTS</span>
        <span class="tb-eyebrow-rule"></span>
    </div>

    <div class="tl-shell">
        <div class="tl-card p-3 mb-3">
            <h2 class="tl-section-title">Hub Tier Lists</h2>

            @if (_isLoading)
            {
                <p class="text-muted mb-1">@_progressMessage</p>
                <div class="progress" role="progressbar" aria-valuenow="@_progressPercent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: @(_progressPercent)%"></div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="alert alert-danger mt-2" role="alert">@_errorMessage</div>
                <button type="button" class="btn btn-outline-light mt-2" @onclick="LoadTierListsAsync">Retry</button>
            }
            else if (_allTierRows.Count == 0)
            {
                <p class="text-muted">No tier list data is currently available.</p>
            }
            else
            {
                <p class="text-muted mt-2">Loaded @_allTierRows.Count ranked entries across all attacker types.</p>
                @foreach (var section in GetHubTierSections())
                {
                    <details class="mb-3" open>
                        <summary class="fw-semibold">@section.Label Tier List (@section.TierList.Count entries)</summary>
                        <div class="table-responsive mt-2">
                            <table class="table table-striped table-sm">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>#</th>
                                        <th>Name</th>
                                        <th>Form</th>
                                        <th>Fast Attack</th>
                                        <th>Charged Attack</th>
                                        <th>DPS</th>
                                        <th>TDO</th>
                                        <th>Score</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pokemon in section.TierList)
                                    {
                                        <tr>
                                            <td>@pokemon.Rank</td>
                                            <td>@pokemon.PokemonNumber</td>
                                            <td>@pokemon.Name</td>
                                            <td>@pokemon.Form</td>
                                            <td>@pokemon.FastAttack</td>
                                            <td>@pokemon.ChargedAttack</td>
                                            <td>@pokemon.DPS</td>
                                            <td>@pokemon.TDO</td>
                                            <td>@pokemon.Score</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                }
            }
        </div>
    </div>
</div>

@code {
    private static readonly string[] _attackerTypes =
    [
        "normal", "fire", "water", "electric", "grass", "ice", "fighting", "poison",
        "ground", "flying", "psychic", "bug", "rock", "ghost", "dragon", "dark",
        "steel", "fairy"
    ];

    private readonly List<HubTierRow> _allTierRows = [];
    private bool _isLoading;
    private string? _errorMessage;
    private string _progressMessage = "Idle";
    private int _progressPercent;
    private CancellationTokenSource? _loadCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadTierListsAsync();
    }

    private async Task LoadTierListsAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource(TimeSpan.FromMinutes(8));
        var cancellationToken = _loadCts.Token;

        _errorMessage = null;
        _allTierRows.Clear();
        _isLoading = true;
        _progressPercent = 0;
        _progressMessage = "Preparing Hub tier list crawl...";
        StateHasChanged();

        try
        {
            for (var i = 0; i < _attackerTypes.Length; i++)
            {
                cancellationToken.ThrowIfCancellationRequested();
                var attackerType = _attackerTypes[i];
                _progressMessage = $"Processing '{attackerType}' tier list ({i + 1}/{_attackerTypes.Length})...";
                StateHasChanged();

                using var perTypeCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
                perTypeCts.CancelAfter(TimeSpan.FromSeconds(120));

                var tierList = await HubApiService.CrawlBestPerTypeAsync(attackerType, 200, perTypeCts.Token);
                AddTierRows(attackerType, tierList);

                _progressPercent = (int)Math.Round(((i + 1d) / _attackerTypes.Length) * 100d);
            }

            _allTierRows.Sort((a, b) =>
            {
                var typeCompare = string.Compare(a.AttackerType, b.AttackerType, StringComparison.OrdinalIgnoreCase);
                if (typeCompare != 0)
                {
                    return typeCompare;
                }

                return (a.Pokemon.Rank ?? int.MaxValue).CompareTo(b.Pokemon.Rank ?? int.MaxValue);
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            _errorMessage = "Tier-list loading was canceled.";
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "Tier-list loading timed out while waiting for Hub data.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load Hub tier lists: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void AddTierRows(string attackerType, IEnumerable<HubRankedPokemon> tierList)
    {
        foreach (var pokemon in tierList)
        {
            _allTierRows.Add(new HubTierRow
            {
                AttackerType = attackerType,
                Pokemon = pokemon
            });
        }
    }

    private IEnumerable<HubTierSection> GetHubTierSections()
    {
        foreach (var attackerType in _attackerTypes)
        {
            var tierList = _allTierRows
                .Where(x => string.Equals(x.AttackerType, attackerType, StringComparison.OrdinalIgnoreCase))
                .Select(x => x.Pokemon)
                .ToList();

            if (tierList.Count == 0)
            {
                continue;
            }

            yield return new HubTierSection
            {
                Label = char.ToUpperInvariant(attackerType[0]) + attackerType[1..],
                TierList = tierList
            };
        }
    }
}
