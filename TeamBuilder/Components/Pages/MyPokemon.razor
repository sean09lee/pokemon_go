@page "/my-pokemon"
@using TeamBuilder.Data.Models
@using TeamBuilder.Data.Responses
@inject PokemonUploadState UploadState

<PageTitle>My Pokemon</PageTitle>

<div class="mp-main">
    <div class="tb-eyebrow-row">
        <span class="tb-eyebrow-icon" aria-hidden="true"><LucideIcon Name="list" Size="14" /></span>
        <span class="tb-eyebrow-text">MY POKEMON</span>
        <span class="tb-eyebrow-rule"></span>
    </div>

    <div class="mp-shell">
        <div class="mp-card p-3 mb-3">
            <h2 class="mp-section-title">Your Pokemon</h2>

            @if (!UploadState.HasUploadedPokemon)
            {
                <p class="text-muted">Upload a CSV from the Raid Builder page to view your Pokémon list.</p>
            }
            else
            {
                @if (UploadState.ValidationFailures.Count > 0)
                {
                    <div class="alert alert-warning" role="alert">
                        Found @UploadState.ValidationFailures.Count validation issue(s). Invalid fields were set to null.
                    </div>

                    <details class="mb-3" open>
                        <summary class="fw-semibold">CSV Validation Issues (showing up to 50)</summary>
                        <div class="table-responsive mt-2">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Row</th>
                                        <th>Column</th>
                                        <th>Value</th>
                                        <th>Issue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var issue in UploadState.ValidationFailures.Take(50))
                                    {
                                        <tr>
                                            <td>@issue.RowNumber</td>
                                            <td>@issue.ColumnName</td>
                                            <td>@issue.RawValue</td>
                                            <td>@issue.Message</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>

                    @if (UploadState.ValidationFailures.Count > 50)
                    {
                        <p class="text-muted">Showing first 50 validation issues.</p>
                    }
                }

                @if (UploadState.Pokemon.Count == 0)
                {
                    <p class="text-muted">Upload a CSV to view your Pokémon list.</p>
                }
                else
                {
                    <details class="mb-3" open>
                        <summary class="fw-semibold">Uploaded Pokémon (@UploadState.Pokemon.Count)</summary>
                        <div class="table-responsive mt-2">
                            <table class="table table-striped table-sm">
                                <thead>
                                    <tr>
                                        <th>Index</th>
                                        <th>#</th>
                                        <th>Name</th>
                                        <th>Form</th>
                                        <th>Gender</th>
                                        <th>CP</th>
                                        <th>HP</th>
                                        <th>Atk/Def/Sta IV</th>
                                        <th>Quick Move</th>
                                        <th>Charge Move</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in UploadState.Pokemon)
                                    {
                                        <tr>
                                            <td>@p.Index</td>
                                            <td>@p.PokemonNumber</td>
                                            <td>@p.Name</td>
                                            <td>@p.Form</td>
                                            <td>@p.Gender</td>
                                            <td>@p.CP</td>
                                            <td>@p.HP</td>
                                            <td>@($"{p.AtkIV}/{p.DefIV}/{p.StaIV}")</td>
                                            <td>@p.QuickMove</td>
                                            <td>@p.ChargeMove</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                }
            }
        </div>
    </div>
</div>
